#!/bin/sh
# The identity guard and the SPA's two checks, before the commit rather than
# after the bug.
#
# Kept honest about cost: the build checks run only when something they could
# possibly fail on is staged, because a hook that takes half a minute on a docs
# commit is a hook everybody learns to pass `--no-verify` to. Warm, this is ~2s.
# The identity guard is the exception and runs always — it is two `git var` calls,
# and the commit it has to catch is as likely to be a docs one as a Rust one.
#
# It checks the *working tree*, not the staged content. Committing a subset of
# your changes can therefore pass a check the commit itself would not — the
# tradeoff for not shuffling files into a temp index on every commit. CI is what
# checks the commit as it lands.
#
# Enable per clone (git will not let a repo point at its own hooks):
#     git config core.hooksPath .githooks
#
# Skip deliberately with `git commit --no-verify` — that is a fine thing to do
# mid-refactor; the gate is `mise run check-web` and CI, not this.

set -e

# The identity, checked before anything else and on every commit — including the
# docs-only ones the checks below exit early on, because a TODO.md commit is one
# of the nine this exists to have stopped.
#
# The tests configure a git identity in their scratch repos: `t@t` in git.rs,
# `me@here` in patch.rs, `e2e@test` in the harness. Those live in /tmp and
# normally stay there, but `git config` with no scope flag writes to
# `$GIT_DIR/config` — so a `cargo test` that inherited GIT_DIR from a parent git
# (a hook, `rebase --exec`) writes them into *this* repo instead. That happened
# on 2026-08-24 at 15:03, along with six stray fixture branches and four
# worktrees registered into /tmp. The next nine commits went out as
# `me <me@here>`, and since the forge attributes by email they were credited to
# whichever stranger has that address on their account. Undoing it means
# rewriting every commit since, so the cheap moment to notice is here.
#
# Judged on the shape of the address rather than a list of the fixtures we
# happen to have today: a domain with no dot, or one RFC 2606 reserves for
# documentation and testing. A real committer's address is neither, and the next
# test to invent an identity is covered without anyone remembering to add it.
#
# `git var` reports what git itself is about to use, so an identity from the
# environment or `-c` is seen too. It does not see `git commit --author=…`, which
# git applies after the hook — that one is a deliberate act, not a spill.
fixture_host() {
  case $1 in
    example.com|example.org|example.net|localhost) return 0 ;;
    *.test|*.example|*.invalid|*.localhost) return 0 ;;
    *.*) return 1 ;;
    *) return 0 ;;
  esac
}

for who in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${who}_IDENT")
  email=${ident#*<}
  email=${email%%>*}
  if fixture_host "${email#*@}"; then
    lc=$(printf '%s' "$who" | tr 'A-Z' 'a-z')
    echo "pre-commit: refusing to commit with $lc <$email> — that is a test" >&2
    echo "            identity, not yours. A cargo test that inherited GIT_DIR" >&2
    echo "            writes its fixture identity into .git/config." >&2
    echo "            Put yours back:" >&2
    echo "              git config user.name  '<your name>'" >&2
    echo "              git config user.email '<your address>'" >&2
    echo "            Then look for the rest of the spill, which is usually" >&2
    echo "            stray refs and worktrees pointing at /tmp:" >&2
    echo "              git for-each-ref --format='%(refname:short) %(authoremail)' refs/heads/" >&2
    echo "              git worktree list" >&2
    exit 1
  fi
done

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

web=0
rust=0
e2e=0
if printf '%s\n' "$staged" | grep -qE '^web/'; then web=1; fi
if printf '%s\n' "$staged" | grep -qE '\.rs$'; then rust=1; fi
# The flows themselves count: changing the harness without running it is how a
# suite quietly stops testing anything.
if printf '%s\n' "$staged" | grep -qE '^tools/e2e/'; then e2e=1; fi
[ "$web" = 1 ] || [ "$rust" = 1 ] || [ "$e2e" = 1 ] || exit 0

if [ "$web" = 1 ] || [ "$rust" = 1 ]; then
if [ ! -d tools/node_modules ]; then
  echo "pre-commit: tools/node_modules is missing — run 'npm install --prefix tools'" >&2
  echo "            (or commit with --no-verify)" >&2
  exit 1
fi
fi

# A Rust change can move the snapshot the SPA is typed against. Regenerate and
# refuse if the committed copy no longer matches the structs.
if [ "$rust" = 1 ]; then
  cargo test --lib export_bindings >/dev/null 2>&1 || {
    echo "pre-commit: the snapshot type export failed to build" >&2; exit 1; }
  if ! git diff --quiet web/snapshot.d.ts; then
    echo "pre-commit: web/snapshot.d.ts is out of date with the Rust structs." >&2
    echo "            The regenerated file is in your tree — stage it:" >&2
    echo "              git add web/snapshot.d.ts" >&2
    exit 1
  fi
fi

if [ "$web" = 1 ]; then
  npx --prefix tools tsc -p tools/tsconfig.json
  npx --prefix tools depcruise --config tools/.dependency-cruiser.cjs web/app.js >/dev/null
fi

# The end-to-end flows, every Nth Rust commit rather than every one.
#
# They cost ~45s, which is twenty times the rest of this hook, so running them
# always would teach everybody to pass `--no-verify` and the hook would then catch
# nothing at all. Never running them means the faults only they can see — a state
# machine driven by hooks over HTTP against a real git repo — wait for CI or for a
# person to remember. Every fifth commit is the middle: a regression is at most
# four commits from the one that caused it, which is still a readable bisect.
#
# Three details that make the count mean something:
#
#   * Only a Rust or harness commit ticks it. A docs or SPA commit cannot break a
#     flow, so it does not spend the count.
#   * The counter lives in `.git/`, so it is per-clone and never committed.
#   * A failing run does **not** reset it, so the next commit tries again. Resetting
#     on failure would bury a real break for four more commits.
#
# `E2E_EVERY=1` to run every time, `E2E_EVERY=0` to turn it off. `--no-verify`
# still skips the lot.
if { [ "$rust" = 1 ] || [ "$e2e" = 1 ]; } && [ "${E2E_EVERY:-5}" != 0 ]; then
  counter="$(git rev-parse --git-dir)/e2e-counter"
  n=$(( $(cat "$counter" 2>/dev/null || echo 0) + 1 ))
  if [ "$n" -lt "${E2E_EVERY:-5}" ]; then
    printf '%s\n' "$n" > "$counter"
    echo "pre-commit: e2e in $(( ${E2E_EVERY:-5} - n )) more qualifying commit(s) (E2E_EVERY=1 to force)"
  else
    echo "pre-commit: running the e2e flows (~45s; every ${E2E_EVERY:-5} qualifying commits)"
    if node tools/e2e/run.mjs; then
      printf '0\n' > "$counter"
    else
      # Left un-reset on purpose: the next commit runs them again rather than
      # waiting out another four.
      echo "pre-commit: an e2e flow failed. The sandbox above has its daemon log." >&2
      echo "            Commit anyway with --no-verify if you know why." >&2
      exit 1
    fi
  fi
fi
