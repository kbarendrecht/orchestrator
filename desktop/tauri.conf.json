{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestrator",
  "version": "2026.9.0",
  "identifier": "dev.orchd.orchestrator",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Kars Barendrecht. Licensed under the AGPL-3.0-only.",
    "licenseFile": "../LICENSE",
    "shortDescription": "Session board for parallel Claude work",
    "longDescription": "Hosts several Claude Code sessions over one monorepo: a rail of what needs you, a terminal per session, the changed files beside it, and the PRs they end up on.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/bin/orch": "../target/release/orch"
        }
      },
      "appimage": {
        "files": {
          "usr/bin/orch": "../target/release/orch"
        }
      }
    },
    "macOS": {
      "files": {
        "MacOS/orch": "../target/release/orch"
      }
    }
  }
}
